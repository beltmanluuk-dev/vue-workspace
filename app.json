{
  "expo": {
    "name": "VUE",
    "slug": "VUE",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./vue.logo.jpg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./vue.logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
,
    "platforms": ["ios", "android", "web"]
  }
}
