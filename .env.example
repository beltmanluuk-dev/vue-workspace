# VUE AI Provider Configuration
# Kopiera denna fil till .env och fyll i din API-nyckel.
# .env ska aldrig checkas in i Git.

# Groq API-nyckel (gratis tier för test). Byt till Claude-nyckel senare om du vill.
EXPO_PUBLIC_GROQ_API_KEY=gsk_...

# Alternativt om du använder en byggprocess utan Expo-public env:
# GROQ_API_KEY=gsk_...

# Tink Open Banking (sandbox/produktion)
EXPO_PUBLIC_TINK_BASE_URL=https://api.tink.com
EXPO_PUBLIC_TINK_CLIENT_ID=your-tink-client-id
EXPO_PUBLIC_TINK_REDIRECT_URL=vue://tink/callback
EXPO_PUBLIC_TINK_ENVIRONMENT=sandbox
